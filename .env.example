# Copy to backend/.env and fill in. Never commit the real .env file.

# --- Database ---
# Local demo (default): SQLite file next to the backend
DATABASE_URL=sqlite:///./smart_tutor.db
# Production: PostgreSQL
# DATABASE_URL=postgresql+psycopg2://tutor:tutor@localhost:5432/smarttutor

# --- Security --- (generate with: python -c "import secrets; print(secrets.token_urlsafe(48))")
SECRET_KEY=change-me
CORS_ORIGINS=http://localhost:5173,http://localhost:8000

# --- LLM: auto | openai | anthropic | offline ---
LLM_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

QUIZ_LENGTH=8

# --- Public deployment ---
# Share the invite code only with real teachers
TEACHER_INVITE_CODE=CIT-TEACHER
# true = 23 fake demo students (for demos); false = clean start (for a real pilot)
SEED_DEMO_STUDENTS=true
